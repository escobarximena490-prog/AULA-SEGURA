{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend-aula-segura ci && npm --prefix frontend-aula-segura run build",
  "outputDirectory": "frontend-aula-segura/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend-aula-segura/sql/**"
    }
  }
}
